{
  "name": "heist-60-seconds",
  "private": true,
  "version": "0.1.0",
  "description": "HEIST: 60 SECONDS — A real-time 3D strategy heist game built with Three.js and Vite.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
